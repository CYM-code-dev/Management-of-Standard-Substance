          WHERE
          (SEQUENCE_ISCURRENT = 1) AND (SAMPLE_ISCURRENT = 1) AND (INJECTION_ISCURRENT = 1) AND                      (SEQUENCE_ID IN (@SequenceID)) AND
          (SAMPLE_ID IN (@SampleID)) AND (INJECTION_ID IN (@InjectionID))
