            <Value>=Parameters!SequenceID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SampleID">
            <Value>=Parameters!SampleID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@InjectionID">
            <Value>=Parameters!InjectionID.Value</Value>
          </QueryParameter>
        </QueryParameters>
