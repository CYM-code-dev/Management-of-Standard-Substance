    <ReportItems>
      <List Name="OLIR_List_Injection">
        <DataSetName>OLIR_DataSet_CompoundsAndPeaks</DataSetName>
        <Grouping Name="OLIR_Sequence_List_Details_Group">
          <GroupExpressions>
            <GroupExpression>=Fields!INJECTION_ID.Value</GroupExpression>
          </GroupExpressions>
          <PageBreakAtEnd>false</PageBreakAtEnd>
        </Grouping>
        <Sorting>
          <SortBy>
            <SortExpression>=Fields!SAMPLE_ACQUISITIONORDERNO.Value</SortExpression>
            <Direction>Ascending</Direction>
          </SortBy>
          <SortBy>
            <SortExpression>=Fields!INJECTION_ORDERNO.Value</SortExpression>
            <Direction>Ascending</Direction>
          </SortBy>
          <SortBy>
            <SortExpression>=Fields!INJECTION_ACQUIREDDATE.Value</SortExpression>
            <Direction>Ascending</Direction>
          </SortBy>
        </Sorting>
